# .env.example - Copy to .env and adjust (never commit .env)

# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — PostgreSQL (required)
# Option A (recommended): single URL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hse_database

# Option B: omit DATABASE_URL and use these instead
# POSTGRES_DB=hse_database
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=YOUR_PASSWORD
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
